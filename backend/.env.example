# ============================================================
# ECOPULSE BACKEND CONFIGURATION
# ============================================================

# Django Core
SECRET_KEY=generate-a-strong-random-secret-key-for-production
DEBUG=False
ALLOWED_HOSTS=*

# Port to expose on the host machine (default: 8000)
PORT=8000

# Database Configuration (PostgreSQL container)
DB_NAME=waste_management
DB_USER=ecopulse_user
DB_PASSWORD=ecopulse_secure_password_123
DB_HOST=db
DB_PORT=5432
DB_SSL_REQUIRE=False

# If using an external managed PostgreSQL (e.g. AWS RDS / Render):
# DATABASE_URL=postgresql://user:password@rds-endpoint.amazonaws.com:5432/dbname
# DB_SSL_REQUIRE=True

# CORS & CSRF Settings
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://ecopulse-nine-pi.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://ecopulse-nine-pi.vercel.app

# Gunicorn Worker Settings
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# Web Push & VAPID Keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@ecopulse.gov.in
